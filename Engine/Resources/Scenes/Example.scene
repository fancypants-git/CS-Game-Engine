meta
{
    version 0.0.1
    name "Example Scene"
    camera Main
}

entity
{
    id Main
    add Transform vec3(0, 15, 0) vec3(0) vec3(90, 180, 0)
    add Camera 0 0.1 100. 100. vec2(0)
}

entity
{
    id Floor
    add Transform vec3(0, 0, 0) vec3(10, 1, 10) vec3(0)
    add Renderer mesh("Objects/cube.obj") shader(unlit)
    
    add BoxCollider 1. layer(Terrain) false
}

entity
{
    id Cube
    add Transform vec3(3, 10, 5) vec3(1) vec3(0)
    add Renderer mesh("Objects/cube.obj") shader(unlit)
    
    add BoxCollider 1. layer(Object) false
    add Rigidbody 1.
    add ColliderRenderer vec3(255,0,0) true
}

entity
{
    id Player
    add Transform vec3(-4, 10, 3) vec3(1, 1, 1) vec3(0)
    add Renderer mesh(Objects/dragon.obj) shader(unlit)
    
    # add BoxCollider 1. layer(Enemy) true
    add CapsuleCollider 1. 1. layer(Enemy) true
add Rigidbody 1.
    add ColliderRenderer vec3(200, 200, 0) true
    
    add PlayerController 3.
    # add CameraController 10. true
}
