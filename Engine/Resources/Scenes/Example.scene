meta
{
    version 0.0.1
    name "Example Scene"
    camera MainCamera
}

entity
{
    id MainCamera
    add Transform vec3(0, 0, 5) vec3(0) vec3(0)
    add Camera

    add PlayerController 3.
    add CameraController 10. false
}

entity
{
    id Floor
    add Transform vec3(1, 0, 0) vec3(0) vec3(1)
    add Renderer mesh(Objects/cube.obj) shader(unlit)
}