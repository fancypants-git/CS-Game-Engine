meta
{
    version 0.0.1
    name "Body Testing"
    camera MainCamera
}

entity
{
    id MainCamera
    add Transform vec3(0, 0, -5) vec3(0) vec3(0)
    # add Camera 1 0.1 100. 90. vec2(20, 20)

    add Camera
    add PlayerController 20.
    add CameraController 10. false
    add BodySpawner
}

entity
{
    id Floor
    add Transform vec3(0, -1, 0) vec3(0) vec3(100, 1, 100)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Terrain)
    add BoxCollider vec3(1)
    # add ColliderRenderer vec3(0, 255, 0) true
}

entity
{
    id Body1
    add Transform vec3(0, 30, 0) vec3(45, 14, 516) vec3(4)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 1.
    add ColliderRenderer vec3(255, 255, 0) true
}