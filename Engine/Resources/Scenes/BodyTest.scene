meta
{
    version 0.0.1
    name "Body Testing"
    camera MainCamera
}

entity
{
    id MainCamera
    add Transform vec3(15, 15, -15) vec3(45, -45, 0) vec3(0)
    add Camera
}

entity
{
    id Player
    add Transform vec3(0, 0, -5) vec3(0) vec3(1)
    # add Camera 1 0.1 100. 90. vec2(20, 20)

    add Camera
    add PlayerController 20.
    add CameraController 10. false

    add PhysicsObject layer(Player) true
    add SphereCollider 2.
    add ColliderRenderer vec3(255) true
}

entity
{
    id Floor
    add Transform vec3(0, -1, 0) vec3(0) vec3(100, 1, 100)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Terrain)
    add BoxCollider vec3(1)
    # add ColliderRenderer vec3(0, 255, 0) true
}

entity
{
    id Body1
    add Transform vec3(0, 10, 0) vec3(45, 14, 516) vec3(4)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 1.
    add ColliderRenderer vec3(255, 255, 0) true
}

entity
{
    id Body2
    add Transform vec3(2, 30, 0) vec3(0, 80, 23) vec3(3)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 3.4
    add ColliderRenderer vec3(255, 255, 0) true
}

entity
{
    id Body3
    add Transform vec3(3, 50, 4) vec3(0, 235, 0) vec3(8)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 0.001
    add ColliderRenderer vec3(255, 255, 0) true
}