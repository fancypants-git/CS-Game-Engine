meta
{
    version 0.0.1
    name "Physics Playground"
    camera Player
}

entity
{
    id MainCamera
    add Transform vec3(35, 30, -35) vec3(35, -45, 0) vec3(1)
    add Camera
}
entity
{
    id Player
    add Transform vec3(0, 2, -10) vec3(0) vec3(1)

    add Camera
    add PlayerController 20.
    add CameraController 10. false

    add PhysicsObject layer(Player) true
    add CapsuleCollider 1. 2.
    # add Rigidbody 80.
    # # add ColliderRenderer vec3(100, 200, 255) true
}

entity
{
    id Floor
    add Transform vec3(0, -2, 0) vec3(0) vec3(200, 2, 200)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Terrain)
    add BoxCollider vec3(1)
}



entity
{
    id StackBase
    add Transform vec3(-20, 0, 0) vec3(0) vec3(6)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 0.
}

entity
{
    id Stack1
    add Transform vec3(-20, 6, 0) vec3(0) vec3(3)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 2.
}

entity
{
    id Stack2
    add Transform vec3(-20, 12, 0) vec3(0) vec3(3)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 2.
}



entity
{
    id HeavyDrop
    add Transform vec3(0, 30, 0) vec3(0) vec3(4)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 50.
    # add ColliderRenderer vec3(255, 0, 0) true
}

entity
{
    id LightDrop
    add Transform vec3(4, 30, 0) vec3(0) vec3(2)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 0.2
    # add ColliderRenderer vec3(0, 255, 0) true
}



entity
{
    id SpinningBody
    add Transform vec3(10, 15, 5) vec3(45, 45, 0) vec3(3)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 5.
    # add ColliderRenderer vec3(255, 255, 0) true
}



entity
{
    id Ramp
    add Transform vec3(20, 2, 0) vec3(0, 0, -25) vec3(20, 2, 10)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Terrain)
    add BoxCollider vec3(1)
}

entity
{
    id RampBox
    add Transform vec3(20, 10, 0) vec3(0) vec3(2)
    add Renderer mesh(Objects/cube.obj) shader(lit)

    add PhysicsObject layer(Object)
    add BoxCollider vec3(1)
    add Rigidbody 1.
}


entity
{
    id BouncySphere
    add Transform vec3(-5, 25, 10) vec3(0) vec3(2)
    # add Renderer mesh(Objects/sphere.obj) shader(lit)

    add PhysicsObject layer(Object)
    add SphereCollider 1.
    add Rigidbody 0.000001
    # add ColliderRenderer vec3(255, 100, 255) false
}
