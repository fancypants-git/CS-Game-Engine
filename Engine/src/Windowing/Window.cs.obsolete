using Engine.Helpers;
using Engine.Debugging;
using Engine.Physics;
using OpenTK.Graphics.OpenGL;
using OpenTK.Windowing.Common;
using OpenTK.Windowing.Desktop;
using System.ComponentModel;

namespace Engine.Windowing;

// Window is an instance of a window
// This window is a part of the EngineApplication
// The First Window Instance to be created is set as the MainWindow of this Engine Application
// Only when this window gets closed, another Window can be assigned as the MainWindow
// Closing the MainWindow does not equal in shutting down the EngineApplication
// To Shut down this Application, call either EngineApplication.RequestShutdown() or MainWindow.CloseWindowAndApplication()

public class Window : GameWindow
{
    protected Window(WindowSettings settings, GameSettings gameSettings)
        : base(GameWindowSettings.Default, new NativeWindowSettings {
            API = ContextAPI.OpenGL,
            Profile = ContextProfile.Core,
            Flags = settings.Flags,
            ClientSize = (OpenTK.Mathematics.Vector2i)settings.WindowSize,
            Vsync = settings.VSync,
            Title = settings.Title,
            StartFocused = true,
            WindowState = settings.WindowState,
            WindowBorder = settings.WindowBorder,
        })
    {
        Settings = settings;
        Winfo.WindowSize = ClientSize;
        
        GameSettings = gameSettings;
        LayerManager.Initialize(GameSettings.Layers);
        PhysicsHandler.Initialize(GameSettings.DoublePhysicsPrecision);
    }
    
    protected WindowSet Settings { get; }
    
    private double _fixedUpdateWaitingTime = 0;

    protected sealed override void OnLoad()
    {
        try
        {
            Awake();
        }
        catch(Exception e)
        {
            Debug.LogErr(e);
        }
        
        Debug.Log(LogType.Launch, "Initializing OpenGL Context");
        try
        {
            base.OnLoad();
            GL.ClearColor(0,0,0, 1.0f);

            GL.Enable(EnableCap.DepthTest);
            GL.DepthFunc(DepthFunction.Less);
            
            GL.Enable(EnableCap.Blend);
            GL.BlendFunc(BlendingFactor.SrcAlpha, BlendingFactor.OneMinusSrcAlpha);
            
            GL.Viewport(0, 0, (int)Winfo.WindowSize.X, (int)Winfo.WindowSize.Y);
            
            Input.Initialize(KeyboardState, MouseState);
        }
        catch(Exception e)
        {
            Debug.LogFatal("Failed to Initialize OpenGL Context! Exiting progam immediately.");
            Debug.LogFatal(e);
            Close();
            return;
        }
        
        Debug.Log(LogType.Launch, "Succesfully Finished Initializing OpenGL Context");
        
        

        try
        {
            Start();
            PhysicsHandler.PhysicsSystem.OptimizeBroadPhase();
        }
        catch (Exception e)
        {
            Debug.LogErr(e);
        }
    }


    protected sealed override void OnUpdateFrame(FrameEventArgs args)
    {
        base.OnUpdateFrame(args);
        
        Time.DeltaTimeDouble = args.Time * Time.TimeScale;

        _fixedUpdateWaitingTime += Time.DeltaTimeDouble;

        while (_fixedUpdateWaitingTime > GameSettings.FixedUpdateDelta)
        {
            try
            {
                Time.FixedDeltaTimeDouble = _fixedUpdateWaitingTime;
                _fixedUpdateWaitingTime -= GameSettings.FixedUpdateDelta;
                
                SceneManager.FixedUpdateScene();
                FixedUpdate();
                
                if (GameSettings.PhysicsUpdate == GameSettings.FixedUpdate)
                    PhysicsHandler.Update(Time.FixedDeltaTime);
            }
            catch (Exception e)
            {
                Debug.LogErr(e);
            }
        }

        try
        {
            SceneManager.UpdateScene();
            Update();
            
            if (GameSettings.PhysicsUpdate == GameSettings.Update)
                PhysicsHandler.Update(Time.DeltaTime);
        }
        catch (Exception e)
        {
            Debug.LogErr(e);
        }
        
        if (!EngineApplication.IsRunning)
        {
            Close();
        }
    }


    protected sealed override void OnRenderFrame(FrameEventArgs args)
    {
        base.OnRenderFrame(args);

        Time.RenderTimeDouble = args.Time * Time.TimeScale;

        GL.Clear(ClearBufferMask.ColorBufferBit | ClearBufferMask.DepthBufferBit);

        try
        {
            SceneManager.RenderScene();
            Debug.Render(SceneManager.ActiveCamera);
        }
        catch (Exception e)
        {
            Debug.LogErr(e);
        }

        SwapBuffers();
    }


    protected sealed override void OnFramebufferResize(FramebufferResizeEventArgs args)
    {
        base.OnFramebufferResize(args);

        GL.Viewport(0, 0, args.Width, args.Height);
        Winfo.WindowSize = new(args.Width, args.Height);
        
        try
        {
            SceneManager.ActiveCamera.SetViewportSize(args.Width, args.Height);
        }
        catch(NullReferenceException)
        {
            Debug.LogWarn("No main camera set for currently active scene!");
        }
        catch(Exception e)
        {
            Debug.LogErr(e);
        }
    }


    protected sealed override void OnClosing(CancelEventArgs args)
    {
        try
        {
            OnClose();

            Debug.LogInfo("Disposing Objects");

            SceneManager.Dispose();
            PhysicsHandler.Dispose();
            Debug.DisposeDrawing();

            Debug.LogInfo("Finished Disposing Objects");
        }
        catch (Exception e)
        {
            Debug.LogErr(e);
        }
        finally
        {
            base.OnClosing(args);
            Debug.Log(LogType.Exit, "Exited Program.");
        }
    }


    protected virtual void Awake()
    {
        
    }
    protected virtual void Start()
    {
        
    }

    protected virtual void Update()
    {
        
    }

    protected virtual void FixedUpdate()
    {
    }
    
    protected virtual void OnClose()
    {
    }
}
